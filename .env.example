# Main assignment workflow requires a valid key. Offline baseline: URBANCART_MODE=local.
URBANCART_MODE=openrouter
OPENROUTER_API_KEY=
URBANCART_CHAT_MODEL=google/gemini-3.1-flash-lite
URBANCART_EMBED_MODEL=openai/text-embedding-3-small
